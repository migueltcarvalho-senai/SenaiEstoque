# =============================================================================
# Configuração do Sistema de Estoque 2D - SENAI
#
# LOCAL (Laragon/XAMPP): copie este arquivo para ".env" e preencha.
# INFINITYFREE: não crie o .env à mão. O GitHub Actions gera o arquivo a partir
#               dos Secrets do repositório a cada deploy (veja DEPLOY.md).
#
# O arquivo .env NUNCA deve ser versionado (já está no .gitignore).
# =============================================================================

# --- Banco de dados MySQL ---
# Local: 127.0.0.1 | InfinityFree: ex. sql123.infinityfree.com (painel > MySQL Databases)
DB_HOST=127.0.0.1
# Porta do MySQL (padrão 3306)
DB_PORT=3306
# Local: senai_estoque_2d | InfinityFree: ex. if0_12345678_estoque
DB_NAME=senai_estoque_2d
# Local: root | InfinityFree: ex. if0_12345678
DB_USER=root
# Local: vazio no Laragon | InfinityFree: senha da conta de hospedagem
DB_PASS=

# --- Aplicação ---
# Fuso horário usado no histórico e nas datas
APP_TIMEZONE=America/Sao_Paulo
